{
  "include": [
    "."
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "components/ui",
    "node_modules",
    "src/supabase/function"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}